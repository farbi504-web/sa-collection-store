# PostgreSQL (Neon): pooled URL for the app, direct URL for schema push
DATABASE_URL=
DIRECT_URL=

# Single owner account for /admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Random secret used to sign the admin session (32+ chars). Generate: openssl rand -hex 32
AUTH_SECRET=

# Image storage (created when you enable Vercel Blob on the project)
BLOB_READ_WRITE_TOKEN=
